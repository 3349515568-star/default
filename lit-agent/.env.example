CONTACT_EMAIL=you@example.com
# 复制本文件为 .env，填入你的真实值。.env 不要提交到 git。

# 当前 config 默认：score=deepseek:deepseek-v4-flash，summary=qwen:qwen-long-latest
DEEPSEEK_API_KEY=your-deepseek-api-key
DASHSCOPE_API_KEY=        # 阿里云通义千问（默认 summary=qwen:qwen-long）

# 可选：要 A/B 或切换其他模型时，填对应那家的 key（没填的 provider 不可用）
ZHIPUAI_API_KEY=          # 智谱 GLM（zhipu:glm-4.6 ...）
ARK_API_KEY=              # 火山引擎豆包（doubao:...）
AI302_API_KEY=            # 302.ai 中转（relay302:claude-... / gpt-... ）
S2_API_KEY=               # 可选：Semantic Scholar API key；留空使用匿名共享额度
OFOX_API_KEY=              # ofox 网关（GPT-5.6 / 图像与视觉模型，共用这一把 key）
